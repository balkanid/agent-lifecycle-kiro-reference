# Copy to .env and fill. Never commit .env.

# BalkanID Public API URL (tenant is determined by your API key)
BALKANID_PUBLIC_API_URL=https://your-tenant.balkanid.app/api/public

# Employee API key (BalkanID UI -> profile menu -> API Keys). The hooks call BalkanID as this employee.
API_KEY_ID=
API_KEY_SECRET=

# Human owner accountable for the agent (must exist in your tenant)
BALKANID_AGENT_OWNER_EMAIL=

# BalkanID integration id of the AWS account the agent works in
INTEGRATION_ID=

# --- Agent identity ---
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
# Developer base profile used ONLY to call sts:AssumeRole for the agent (blank = default chain)
BALKANID_DEVELOPER_PROFILE=
# Lifetime of each agent credential set, in seconds (15 minutes)
AGENT_CREDENTIAL_SECONDS=900
# Optional: name stamped as STS SourceIdentity (defaults to your OS user)
# BALKANID_DEVELOPER_ID=
# Optional: path to aws CLI if not on PATH
# AWS_CLI=

# --- Service account gate (CREATE_SERVICE_ACCOUNT) ---
# Baseline policy reviewed on the request; matches agent_policy_arns in terraform/agent-role
SERVICE_ACCOUNT_POLICY_NAME=ViewOnlyAccess
# SERVICE_ACCOUNT_POLICY_ID=

# --- Hook behaviour ---
# How long a cached "approved" status may be used if BalkanID is unreachable (fail closed after)
BALKANID_MAX_STALE_SECONDS=3600
# Optional: where hooks keep status cache, short-lived credentials and the audit log
# BALKANID_KIRO_STATE_DIR=~/.cache/balkanid-kiro

# Approval polling for register_agent.py and service_account_gate.py
POLL_SECONDS=5
POLL_TIMEOUT_SECONDS=900

# --- Advanced (defaults shown) ---
# AGENT_ROLE_ARN=                      # defaults to the role terraform/agent-role creates
# SERVICE_ACCOUNT_EXPIRATION_DATE=     # ISO 8601; expiry for the agent role request
# SERVICE_ACCOUNT_AWS_SERVICE_NAMES=   # optional AWS service principals on the role request
# SERVICE_ACCOUNT_ROLE_DESCRIPTION=
# IDENTITY_LOOKUP_TIMEOUT_SECONDS=300  # setup_agent_profile.py waiting for BalkanID to sync the role
# TRIGGER_INTEGRATION_SYNC=true        # trigger_sync.py; set false to skip
# GQL_MAX_RETRIES=5                    # hooks use 2
# GQL_RETRY_BACKOFF_SECONDS=2          # hooks use 1
# GQL_TIMEOUT_SECONDS=120              # hooks use 8
# BALKANID_ALLOW_UNBOUND_APPROVAL=false  # never set true in production; see docs/ARCHITECTURE.md
# BALKANID_SKIP_DOTENV=false           # tests and CI: ignore .env
# BALKANID_KIRO_ROOT=                  # CI: verify another checkout's .kiro/ with trusted scripts
