{
  "version": 1,
  "description": "Client-side guardrails evaluated by scripts/kiro_hook.py on every Kiro PreToolUse event. Deny rules are final. Sensitive rules require a live, approved BalkanID grant on the agent's own service account. Patterns are case-insensitive regular expressions matched against every string in the tool input.",
  "require_agent_profile_for_aws_cli": true,
  "status_cache_seconds": 300,
  "deny": [
    {
      "id": "developer-credentials",
      "message": "Agents may not read, export or reuse the developer's AWS credentials, profiles, or the BalkanID API key. They run as their own BalkanID-issued identity.",
      "patterns": [
        "\\.aws/(credentials|config|sso/cache|cli/cache)",
        "aws\\b[^;|&\\n]*?\\bconfigure\\s+(export-credentials|get|list|set)",
        "aws\\b[^;|&\\n]*?\\bsts\\s+get-session-token",
        "aws\\b[^;|&\\n]*?\\bsso\\s+(login|get-role-credentials)",
        "AWS_(ACCESS_KEY_ID|SECRET_ACCESS_KEY|SESSION_TOKEN|PROFILE|DEFAULT_PROFILE|CONFIG_FILE|SHARED_CREDENTIALS_FILE)\\s*=",
        "(^|[\\s;&|(])printenv\\b",
        "(^|[\\s;&|(])env(\\s*$|\\s*[|;&>])",
        "\\bset\\s*(\\||$)",
        "API_KEY_(ID|SECRET)",
        "(^|[\\s/'\\\"=<])\\.env(\\s|$|['\\\";|&])",
        "\\.cache/balkanid-kiro"
      ]
    },
    {
      "id": "privilege-escalation",
      "message": "Agents may not change IAM, assume other roles or touch the organization. Request access in BalkanID instead.",
      "patterns": [
        "aws\\b[^;|&\\n]*?\\biam\\s+(create|attach|put|update|add|delete|detach|remove|pass|tag|untag)-",
        "aws\\b[^;|&\\n]*?\\bsts\\s+assume-role",
        "aws\\b[^;|&\\n]*?\\borganizations\\s+",
        "aws\\b[^;|&\\n]*?\\bsso-admin\\s+",
        "aws\\b[^;|&\\n]*?\\bidentitystore\\s+"
      ]
    },
    {
      "id": "guardrail-tampering",
      "message": "Agents may not read or change their own configuration, hooks, BalkanID registration, guardrail scripts or credential cache.",
      "patterns": [
        "\\.kiro/(agents|hooks|balkanid)\\b",
        "registrations\\.json",
        "scripts/(kiro_hook|guardrails|kiro_config|agent_credentials|setup_agent_profile|register_agent|service_account_gate|balkanid_api|trigger_sync)\\.py",
        "\\.cache/balkanid-kiro"
      ]
    },
    {
      "id": "destructive-operations",
      "message": "Destructive infrastructure and data operations are blocked for agents.",
      "patterns": [
        "\\brm\\s+(-[a-zA-Z]*\\s+)*(-[a-zA-Z]*[rR][a-zA-Z]*)\\s+(-[a-zA-Z]*\\s+)*(/|~|\\$HOME)(/|\\*)?(\\s|$)",
        "terraform\\s+destroy",
        "terraform\\s+apply\\b.*-auto-approve",
        "aws\\b[^;|&\\n]*?\\bs3\\s+rb\\b",
        "aws\\b[^;|&\\n]*?\\bs3\\s+rm\\b.*--recursive",
        "aws\\b[^;|&\\n]*?\\b(rds|dynamodb|ec2|eks|lambda|cloudformation|ecr|ecs|kms|secretsmanager)\\s+(delete|deregister|schedule-key-deletion|terminate)-?",
        "git\\s+push\\b.*(--force|\\s-f\\b|\\s\\+[\\w./-]+)"
      ]
    }
  ],
  "sensitive": [
    {
      "id": "secrets-read",
      "message": "Reading secrets requires a time-bound BalkanID approval with step-up verification.",
      "patterns": [
        "secretsmanager\\s+get-secret-value",
        "ssm\\s+get-parameters?\\b.*--with-decryption",
        "kms\\s+decrypt"
      ],
      "grant": {
        "type": "policy",
        "source_name": "BalkanIDAgentSecretsRead"
      },
      "duration_seconds": 900
    },
    {
      "id": "production-access",
      "message": "Touching production resources requires a time-bound BalkanID approval with step-up verification.",
      "patterns": [
        "aws\\s+.*\\b(prod|production)\\b"
      ],
      "grant": {
        "type": "policy",
        "source_name": "BalkanIDAgentProductionReadOnly"
      },
      "duration_seconds": 900
    },
    {
      "id": "customer-data",
      "message": "Reading customer data requires a time-bound BalkanID approval with step-up verification.",
      "patterns": [
        "s3://[^\\s]*(customer|pii|cardholder)"
      ],
      "grant": {
        "type": "policy",
        "source_name": "BalkanIDAgentCustomerDataRead"
      },
      "duration_seconds": 900
    }
  ]
}
